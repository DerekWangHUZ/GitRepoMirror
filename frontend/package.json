{
  "name": "git-repo-mirror-ui",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.js *.json",
    "format:check": "prettier --check src tests *.js *.json",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
